{
  "name": "jarvis-codex",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "wake:build": "node scripts/build-wake-helper.mjs",
    "predev": "npm run wake:build",
    "dev": "tauri dev",
    "prebuild": "npm run wake:build",
    "build": "tauri build",
    "build:windows": "tauri build --bundles nsis",
    "web:dev": "vite",
    "web:build": "tsc && vite build",
    "test": "node --test tests/wav.test.mjs",
    "check": "npm run wake:build && npm test && npm run web:build && cargo fmt --manifest-path src-tauri/Cargo.toml --check && cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets -- -D warnings"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4",
    "typescript": "^7.0.2",
    "vite": "^8.1.5"
  },
  "engines": {
    "node": ">=20"
  }
}
